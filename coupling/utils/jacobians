def randomsvd_each(J, K, L, E, ITS):
    dl = J.shape[0]
    dr = J.shape[1]
    k = K + E
    l = K + E + L
    its = ITS

    def mml(Q):
        #print(J.dtype)
        #print(Q.dtype)
        tmp = J.T @ Q
        return J @ tmp
    def mmr(Q):
        tmp = J @ Q
        return J.T @ tmp
    Dl, U = randomevd(mml, dl, k, l, its, 'cpu')
    Dr, V = randomevd(mmr, dr, k, l, its, 'cpu')
    #print(Dl - Dr)
    #print(Dl)
    return U, Dl ** 0.5, V

